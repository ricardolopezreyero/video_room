# RLR · Cabeceras: lo estático vive en el navegador y se renueva por detrás
# (stale-while-revalidate con max-age=0: se usa al instante lo guardado y en
# paralelo se pregunta al servidor; una publicación nueva llega en la
# siguiente navegación, nunca en 10 minutos). Solo las fuentes son inmutables.
# Las páginas HTML de la app no traen datos (los piden a /api), por eso pueden
# servirse al instante y actualizarse en silencio. Link: preload = Early Hints.

/*.html
  Content-Type: text/html; charset=utf-8

/
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, stale-while-revalidate=86400
  Link: </style.css>; rel=preload; as=style, </veloz.js>; rel=preload; as=script, </fonts/plus-jakarta-sans.woff2>; rel=preload; as=font; type=font/woff2; crossorigin

/app/*
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, stale-while-revalidate=86400
  Link: </style.css>; rel=preload; as=style, </veloz.js>; rel=preload; as=script, </fonts/plus-jakarta-sans.woff2>; rel=preload; as=font; type=font/woff2; crossorigin

/style.css
  Cache-Control: public, max-age=0, stale-while-revalidate=604800

/veloz.js
  Cache-Control: public, max-age=0, stale-while-revalidate=604800

/room.js
  Cache-Control: public, max-age=0, stale-while-revalidate=604800

/motor-video.js
  Cache-Control: public, max-age=0, stale-while-revalidate=604800

/motor-audio.js
  Cache-Control: public, max-age=0, stale-while-revalidate=604800

/puente-login.js
  Cache-Control: public, max-age=0, stale-while-revalidate=604800

/utm.js
  Cache-Control: public, max-age=0, stale-while-revalidate=604800

/og-default.svg
  Cache-Control: public, max-age=0, stale-while-revalidate=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: no-cache

/embed.js
  Content-Type: text/javascript; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
